# GitHub App Configuration
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./private-key.pem
GITHUB_WEBHOOK_SECRET=

# Rigour Configuration
RIGOUR_API_URL=https://mcp.rigour.run/api
RIGOUR_CONFIG_PATH=./rigour.yml
RIGOUR_EXEC_MODE=cli_first
RIGOUR_DEEP_ENABLED=false
RIGOUR_DEEP_MODE=off
RIGOUR_PROVIDER=
RIGOUR_API_KEY=
RIGOUR_API_BASE_URL=
RIGOUR_MODEL_NAME=
RIGOUR_TIMEOUT_MS=90000
RIGOUR_MAX_CONCURRENCY=2
RIGOUR_FALLBACK_TO_MCP=true
RIGOUR_SECURITY_AUDIT_ENABLED=false
RIGOUR_DEEP_ALLOWED_REPOS=
RIGOUR_DEEP_ALLOWED_ORGS=
RIGOUR_MAX_CHANGED_LOC_FOR_DEEP=3000

# Server Configuration
PORT=3000
NODE_ENV=development

# Optional: Smee webhook proxy for local development
WEBHOOK_PROXY_URL=
